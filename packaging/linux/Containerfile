FROM ghcr.io/astral-sh/uv:0.11.15 AS uv
FROM node:22-bookworm-slim AS node

FROM ubuntu:24.04 AS smoke

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        file \
        libasound2t64 \
        libgbm1 \
        libgl1-mesa-dri \
        libgtk-3-0t64 \
        libnss3 \
        procps \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

USER ubuntu
WORKDIR /work

FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=node /usr/local/ /usr/local/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        file \
        git \
        libprotobuf-dev \
        librsvg2-bin \
        ninja-build \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

RUN uv python install 3.13
RUN git config --system --add safe.directory /work/firmware/Carvera_Community_Firmware

COPY packaging/linux/electron/package.json packaging/linux/electron/package-lock.json /opt/carvera-electron/
RUN npm ci --prefix /opt/carvera-electron

ENV UV_PYTHON_PREFERENCE=only-managed
WORKDIR /work
